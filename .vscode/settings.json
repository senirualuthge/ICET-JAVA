{
    "java.debug.settings.onBuildFailureProceed": true,
    "java.project.outputPath": ".vscode/out",
    "java.project.referencedLibraries": [
        "lib/mysql-connector-j-9.0.0.jar"
    ],
    "java.templates.newFile.enabled": false,
    "java.project.sourcePaths": [
        "swing",
        "Tasks",
        "Singleton Desing",
        "SQLConn",
        "Operators",
        "OOP",
        "Methods",
        "Input",
        "InOut",
        "Formatting",
        "Flowcontrol",
        "Coursework",
        "Casting",
        "Basics",
        "Assignment",
        "Arrays",
        "ArraySorting",
        "VerticalLevel"
    ],
    "code-runner.executorMap": {            "java": "JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-25.jdk/Contents/Home bash \"${workspaceFolder}/run.sh\" \"${fileBasenameNoExtension}\""
    },
    "code-runner.clearPreviousOutput": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.runInTerminal": true,
    "code-runner.respectShebang": false,
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-25",
            "path": "/Library/Java/JavaVirtualMachines/temurin-25.jdk/Contents/Home",
            "default": true
        },
        {
            "name": "JavaSE-21",
            "path": "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
        },
        {
            "name": "JavaSE-27",
            "path": "/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home"
        }
    ]
}
